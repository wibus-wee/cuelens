{
  "name": "@wibus/interactive-film",
  "version": "0.1.0",
  "description": "A typed runtime for interactive, camera-driven product films.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wibus/interactive-film.git"
  },
  "bugs": {
    "url": "https://github.com/wibus/interactive-film/issues"
  },
  "homepage": "https://github.com/wibus/interactive-film#readme",
  "author": "wibus",
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02f3a09ec066a1e3b41f0192b9dd",
  "license": "MIT"
}
