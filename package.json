{
  "name": "@wibus/cuelens",
  "version": "0.1.0",
  "description": "Cuelens is a typed runtime for interactive, camera-driven product films.",
  "keywords": [
    "animation",
    "camera",
    "cuelens",
    "interactive-film",
    "onboarding",
    "product-tour",
    "react",
    "timeline"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "install.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm build && node scripts/verify-package.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:package && pnpm format:check",
    "prepublishOnly": "pnpm check",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wibus-wee/cuelens.git"
  },
  "bugs": {
    "url": "https://github.com/wibus-wee/cuelens/issues"
  },
  "homepage": "https://github.com/wibus-wee/cuelens#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "wibus",
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02f3a09ec066a1e3b41f0192b9dd",
  "license": "MIT"
}
